<Project><PropertyGroup>
<Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
<LangVersion>12</LangVersion><AnalysisLevel>latest</AnalysisLevel>
<EnableNETAnalyzers>true</EnableNETAnalyzers><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
<Deterministic>true</Deterministic><InvariantGlobalization>false</InvariantGlobalization>
</PropertyGroup></Project>
